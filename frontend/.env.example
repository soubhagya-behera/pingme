# H5 ALIGNED: API/WS origins consistent with backend defaults (http://localhost:5173 frontend origin allowed by backend).
# Local development defaults. Copy to .env for local overrides (never commit secrets).
# Production: set VITE_API_URL and VITE_WS_URL to your deployed backend without source modification.
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
